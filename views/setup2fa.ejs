<%- include('partials/header') %>

<div class="page-header">
  <h2><i class="fa-solid fa-key"></i> Two-Factor Authentication Settings</h2>
  <p>Protect your account with Time-based One-Time Passwords (TOTP)</p>
</div>

<div class="dashboard-grid">
  <% if (isAlreadyEnabled) { %>
    <!-- Status Card: 2FA Active -->
    <div class="card status-card enabled">
      <div class="status-icon-box">
        <i class="fa-solid fa-shield-check"></i>
      </div>
      <div class="status-info">
        <h3>2FA Protection Enabled</h3>
        <p>Your account is protected with Google Authenticator TOTP verification.</p>
        <span class="badge-status-active"><i class="fa-solid fa-circle"></i> Active & Protected</span>
      </div>

      <div class="status-actions">
        <form action="/disable-2fa" method="POST" onsubmit="return confirm('Are you sure you want to disable 2FA protection?');">
          <button type="submit" class="btn btn-danger">
            <i class="fa-solid fa-shield-xmark"></i> Disable 2FA Protection
          </button>
        </form>
      </div>
    </div>
  <% } else { %>
    <!-- Setup Card: Enable 2FA -->
    <div class="card setup-card">
      <div class="card-header border-bottom">
        <h3><i class="fa-solid fa-qrcode"></i> Setup Google Authenticator 2FA</h3>
        <p>Follow the steps below to connect your mobile authenticator app</p>
      </div>

      <div class="setup-steps-grid">
        <!-- Step 1: Download App -->
        <div class="step-box">
          <div class="step-number">1</div>
          <div class="step-content">
            <h4>Install Authenticator App</h4>
            <p>Download <strong>Google Authenticator</strong>, <strong>Authy</strong>, or <strong>1Password</strong> on your iOS or Android device.</p>
          </div>
        </div>

        <!-- Step 2: Scan QR Code -->
        <div class="step-box">
          <div class="step-number">2</div>
          <div class="step-content">
            <h4>Scan QR Code</h4>
            <p>Open your app and scan the QR code below or manually enter the secret key.</p>
            
            <div class="qr-container">
              <% if (qrCodeUrl) { %>
                <img src="<%= qrCodeUrl %>" alt="2FA QR Code" class="qr-code-img">
              <% } %>
            </div>

            <div class="secret-key-box">
              <label>Manual Entry Secret Key:</label>
              <code class="code-secret" id="secret-key-text"><%= secretKey %></code>
              <button type="button" class="btn-copy" onclick="copySecretKey()">
                <i class="fa-solid fa-copy"></i> Copy
              </button>
            </div>
          </div>
        </div>

        <!-- Step 3: Verify & Activate -->
        <div class="step-box">
          <div class="step-number">3</div>
          <div class="step-content">
            <h4>Confirm Verification Code</h4>
            <p>Enter the 6-digit code generated by your app to activate 2FA.</p>

            <form action="/verify-2fa" method="POST" class="verify-2fa-form">
              <div class="form-group">
                <input 
                  type="text" 
                  name="token" 
                  class="form-control otp-input" 
                  placeholder="123456" 
                  maxlength="6" 
                  pattern="\d{6}" 
                  required
                >
              </div>
              <button type="submit" class="btn btn-success btn-block btn-lg">
                <i class="fa-solid fa-shield-check"></i> Activate 2FA Protection
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  <% } %>
</div>

<script>
  function copySecretKey() {
    const text = document.getElementById('secret-key-text').innerText;
    navigator.clipboard.writeText(text).then(() => {
      alert('Secret key copied to clipboard!');
    }).catch(err => {
      console.error('Failed to copy text:', err);
    });
  }
</script>

<%- include('partials/footer') %>
